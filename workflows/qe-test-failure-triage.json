        "text": "=🚨 *AUTOMATED TEST TRIAGE ALERT* 🚨\n\n*Test Case:* {{ $('Prepare').item.json.test_case_id }} — {{$('Prepare').item.json.test_name }}\n*Application:* {{ $('Prepare').item.json.application }} (`{{ $('Prepare').item.json.environment }}`)\n*Bug Title:* {{ $json.output.bug_title }}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n📊 *Triage Details:*\n• *Priority:* {{ $json.output.priority }} ⚠️\n• *Severity:* {{ $json.output.severity }} ⚡\n• *Failing Component:* {{ $('Extract').item.json.output.failing_component }}\n• *Failure Domain:* {{ $('Extract').item.json.output.failure_domain }}\n\n🔍 *Root Cause Analysis:*\n> {{ $('Extract').item.json.output.extracted_root_cause }}\n\n💡 *Recommended Action:*\n{{ $json.output.recommended_action }}",
        "otherOptions": {}
