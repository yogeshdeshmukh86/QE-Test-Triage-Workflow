        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\"],\n      \"description\": \"Priority level based on strict classification rules.\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\"],\n      \"description\": \"Severity level based on error impact.\"\n    },\n    \"bug_title\": {\n      \"type\": \"string\",\n      \"description\": \"Concise summary line for ticket creation or alerts.\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\",\n      \"description\": \"Specific triage recommendation for engineering.\"\n    },\n    \"is_flaky\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if the failure is due to a timeout or flaky selector.\"\n    }\n  },\n  \"required\": [\"priority\", \"severity\", \"bug_title\", \"recommended_action\", \"is_flaky\"]\n}"
